<% layout("layouts/boilerplate.ejs") %>

<!-- Displays listing details and user reviews -->

<div class="row mt-3">
    <div class="col-6 offset-3">

        <h3 class="mb-3"><b><%= listing.title %></b></h3>

        <div class="card show-card listing-card">
            <img src="<%= listing.image.url %>" 
                 class="card-img-top show-img" 
                 alt="Listing image">

            <div class="card-body">
                <p class="card-text">
                    <i>Hosted by <%= listing.owner.username %></i>
                    <br>
                    <%= listing.description %> <br>
                    &#8377;<%= listing.price.toLocaleString("en-IN") %> / night <br>
                    <%= listing.location %> <br>
                    <%= listing.country %>
                </p>
            </div>
        </div>

        <% if (currUser && currUser._id.equals(listing.owner._id)) { %>
            <div class="btns mt-3 mb-5">

                <a href="/listings/<%= listing._id %>/edit"
                   class="btn btn-dark edit-btn">
                   Edit
                </a>

                <form method="POST"
                      action="/listings/<%= listing._id %>?_method=DELETE">
                    <button class="btn btn-dark delete-btn">Delete</button>
                </form>

            </div>
        <% } %>

        <hr>

        <div>

        <% if (currUser) { %>

            <h4>Leave a review</h4>

            <form class="needs-validation"
                  method="post"
                  action="/listings/<%= listing._id %>/reviews"
                  novalidate>

                <div class="mt-3 mb-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input id="rating" min="1" max="5"
                           type="range"
                           name="review[rating]"
                           class="form-range">
                </div>

                <div class="mt-3 mb-3">
                    <label for="comment" class="form-label">Comment</label>
                    <textarea 
                        id="comment"
                        cols="30"
                        rows="5"
                        name="review[comment]"
                        class="form-control"
                        required></textarea>
                    <div class="invalid-feedback">
                        Please enter a comment for your review
                    </div>
                </div>

                <button class="mb-3 btn btn-outline-dark">Submit</button>
            </form>

            <hr>
        <% } %>

            <p><b>All Reviews</b></p>

            <div class="row">
                <% for (let review of listing.reviews) { %>
                    <div class="card col-5 mb-3 ms-3">
                        <div class="card-body mb-2">
                            <h5 class="card-title">@<%= review.author.username %></h5>
                            <p class="card-text"><%= review.comment %></p>
                            <p class="card-text"><%= review.rating %> stars</p>
                        </div>

                        <form class="mb-3"
                              method="post"
                              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                    </div>
                <% } %>
            </div>

        </div>
    </div>
</div>